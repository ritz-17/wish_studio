# Copy to /opt/wish-studio/.env on the server and fill in the values.

# Generate with: openssl rand -hex 24   (hex keeps it safe inside the database URL)
POSTGRES_PASSWORD=change-me

# The address people type in the browser. Use the server's Elastic IP until you have a domain.
WEB_ORIGINS=http://203.0.113.10

# ":80" serves plain HTTP on the IP. Later: your domain, e.g. wishstudio.com, for automatic HTTPS.
SITE_ADDRESS=:80

# ghcr.io/<your-github-username-or-org>, all lowercase.
IMAGE_PREFIX=ghcr.io/your-github-username
