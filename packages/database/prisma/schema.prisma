generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Occasion {
  BIRTHDAY
  ANNIVERSARY
  RETIREMENT
  GRADUATION
}

model Wish {
  id         String   @id @default(cuid())
  occasion   Occasion
  recipients String[]
  message    String   @db.Text
  createdAt  DateTime @default(now())
}